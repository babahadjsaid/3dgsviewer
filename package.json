{
  "name": "@baba_hadjsaid/3dgsviewer",
  "version": "1.0.1",
  "description": "Embeddable 3D Gaussian Splatting viewer (PlayCanvas) with a React component, a framework-free core and a feature plug-in API",
  "author": {
    "name": "Baba HADJ SAID",
    "email": "baba066h.s@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./viewer": "./dist/viewer.js",
    "./features": "./dist/features/index.js",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "playcanvas": ">=2.13.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "keywords": [
    "gaussian-splatting",
    "3dgs",
    "splat",
    "ply",
    "sog",
    "playcanvas",
    "viewer",
    "react"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "prepublishOnly": "npm run build && npm run check",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "playcanvas": "2.13.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "vite": "6.0.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babahadjsaid/3dgsviewer.git"
  },
  "bugs": {
    "url": "https://github.com/babahadjsaid/3dgsviewer/issues"
  },
  "homepage": "https://github.com/babahadjsaid/3dgsviewer#readme"
}
